  "about": [
    {
      "id": 1,
      "label": "Profile",
      "body": "I'm Dhruv Sharma, an independent filmmaker based in Indore, India, working towards a career in film direction. My interest sits where a story takes its shape: direction, visual storytelling, cinematography and production.",
      "sort_order": 1
    },
    {
      "id": 2,
      "label": "Journey",
      "body": "My way into filmmaking has been through making films. Each independent project is a chance to carry a story from the page to the frame, and to understand a little more of what a film asks of the people making it.",
      "sort_order": 2
    },
    {
      "id": 3,
      "label": "Education",
      "body": "My formal education is up to Higher Secondary (Class 12). I am a self-taught filmmaker who has independently learned filmmaking and direction through hands-on experience, practical experimentation, and continuous creative exploration.",
      "sort_order": 3
    },
    {
      "id": 4,
      "label": "Independent Work",
      "body": "Alongside that training I make independent short films and personal projects, among them the short film I AM HERE.",
      "sort_order": 4
    },
    {
      "id": 5,
      "label": "Philosophy",
      "body": "Stories begin long before the camera rolls. A film is decided in its preparation: the script breakdown, the shot list, the storyboard, the blocking. By the time we shoot, every frame should already have a reason to exist.",
      "sort_order": 5
    },
    {
      "id": 6,
      "label": "Aspirations",
      "body": "I am working towards becoming a film director. Right now I want to learn inside the direction department, on independent films and alongside experienced directors and production teams.",
      "sort_order": 6
    }
  ],
